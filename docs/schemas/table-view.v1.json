          "title": "Hand Id"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "hand_id",
        "type",
        "data"
      ],
      "title": "PublicEvent",
      "type": "object"
    }
  },
