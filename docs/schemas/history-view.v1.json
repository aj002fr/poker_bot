      "title": "Schema Version",
      "type": "integer"
    },
    "table_complete": {
      "title": "Table Complete",
      "type": "boolean"
    },
    "table_id": {
      "title": "Table Id",
      "type": "string"
    },
    "viewer_seat": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Viewer Seat"
    }
  },
  "required": [
    "perspective",
    "table_id",
    "viewer_seat",
    "table_complete",
    "events"
